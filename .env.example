# Subarashii — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# See SETUP.md for where to find each value.

# --- Supabase ---
# Only the URL + service-role key are needed now — task #24's PIN-auth
# migration removed the per-user/browser Supabase client (and with it the
# anon key and the magic-link redirect URL), so the app talks to Supabase
# exclusively through the service-role client, which bypasses Row Level
# Security entirely (see src/lib/supabase/service.ts).
NEXT_PUBLIC_SUPABASE_URL=

# --- Supabase (SECRET — server only, never exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared app PIN (SECRET) ---
# Replaces Supabase magic-link auth (task #24) — this is a private 2-person
# app, so one shared PIN unlocks a long-lived signed cookie instead of each
# person needing their own account. Pick any string; changing it instantly
# signs everyone out (see src/lib/session.ts).
APP_PIN=

# --- Ingest endpoint secret (SECRET — used by the iOS Shortcut) ---
# Generate a long random string, e.g.:  openssl rand -hex 32
INGEST_TOKEN=

# --- Nutrition (task #20: nutrition chips) ---
USDA_API_KEY=
# Israeli food-composition database (Tzameret), served live via data.gov.il's
# datastore_search API — no file download needed, just query this resource.
TZAMERET_RESOURCE_ID=
# LLM fallback for ingredients neither database matches (free tier):
# get a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=
