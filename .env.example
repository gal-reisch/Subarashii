# Subarashii — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# See SETUP.md for where to find each value.

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET — server only, never exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest endpoint secret (SECRET — used by the iOS Shortcut) ---
# Generate a long random string, e.g.:  openssl rand -hex 32
INGEST_TOKEN=

# --- Site URL (used for magic-link redirects) ---
# Local dev: http://localhost:3000 . Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Nutrition (task #20: nutrition chips) ---
USDA_API_KEY=
# Israeli food-composition database (Tzameret), served live via data.gov.il's
# datastore_search API — no file download needed, just query this resource.
TZAMERET_RESOURCE_ID=
# LLM fallback for ingredients neither database matches (free tier):
# get a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=
