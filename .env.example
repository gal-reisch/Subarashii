# Subarashii — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# See SETUP.md for where to find each value.

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET — server only, never exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest endpoint secret (SECRET — used by the iOS Shortcut) ---
# Generate a long random string, e.g.:  openssl rand -hex 32
INGEST_TOKEN=

# --- Site URL (used for magic-link redirects) ---
# Local dev: http://localhost:3000 . Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Nutrition (Phase 3 — not needed yet) ---
# USDA_API_KEY=
